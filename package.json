{
  "name": "@peter.naydenov/log",
  "description": "Controlable log message system",
  "version": "1.1.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/log.umd.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.esm.mjs",
      "require": "./dist/log.cjs",
      "default": "./dist/log.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "mocha test",
    "cover": "c8 mocha test",
    "build:types": "tsc && node -e \"require('fs').renameSync('dist/main.d.ts','dist/log.d.ts')\"",
    "build": "npm run build:types && rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/log.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "rollup": "^4.62.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "keywords": [
    "console",
    "log",
    "error",
    "warn"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
