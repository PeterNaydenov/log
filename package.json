{
  "name": "@peter.naydenov/log",
  "description": "Controlable log message system",
  "version": "1.1.3",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/log.umd.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.esm.mjs",
      "require": "./dist/log.cjs",
      "default": "./dist/log.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build:types": "tsc && node -e \"require('fs').renameSync('dist/main.d.ts','dist/log.d.ts')\"",
    "build": "npm run build:types && rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/log.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "rollup": "^4.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "console",
    "log",
    "error",
    "warn"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
